# Plantilla del application.properties de PRODUCCIÓN.
# En el VPS se copia a /opt/pizzacode/application.properties y se llenan los valores reales.
# NUNCA subir el archivo con valores reales al repositorio.

spring.application.name=pizza-code

# Solo accesible desde Nginx, dentro del VPS
server.port=8090
server.address=127.0.0.1

# Base de datos del VPS (usuario propio con permisos solo sobre "pizzeria")
spring.datasource.url=jdbc:mysql://localhost:3306/pizzeria?serverTimezone=America/Mexico_City
spring.datasource.username=CAMBIAR
spring.datasource.password=CAMBIAR
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Flyway crea las tablas; JPA solo valida
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.show-sql=false

# JWT: clave nueva y larga, distinta a la de desarrollo (openssl rand -base64 48)
jwt.secret=CAMBIAR
jwt.expiration-ms=86400000

# Correo: Postfix del mismo VPS
spring.mail.host=localhost
spring.mail.port=25

# Twilio (SMS)
twilio.account-sid=CAMBIAR
twilio.auth-token=CAMBIAR
twilio.sms-from=CAMBIAR
# Solo cuenta de prueba de Twilio. Vacío = se manda el texto de la app
twilio.sms-plantilla=