meta {
  name: Login cliente
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "cliente@pizzacode.mx",
    "contrasena": "Cliente#2026"
  }
}

script:post-response {
  bru.setVar("tokenCliente", res.body.token);
}

tests {
  test("login cliente: 200", () => {
    expect(res.status).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
