meta {
  name: Editar con rol inválido
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/usuarios/{{idEmpleado}}
  body: json
  auth: bearer
}

body:json {
  {
    "rol": "CLIENTE"
  }
}

auth:bearer {
  token: {{token}}
}

tests {
  test("editar con rol inválido: 400", () => {
    expect(res.status).to.equal(400);
    expect(res.body.errors).to.have.property("rol");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
