meta {
  name: Bloquear empleado
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/usuarios/{{idEmpleado}}/bloqueo
  body: json
  auth: bearer
}

body:json {
  {
    "motivo": "Prueba de bloqueo"
  }
}

auth:bearer {
  token: {{token}}
}

tests {
  test("bloquear empleado: 200", () => {
    expect(res.status).to.equal(200);
    expect(res.body.estado).to.equal("BLOQUEADO");
    expect(res.body.motivoBloqueo).to.equal("Prueba de bloqueo");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
