meta {
  name: Editar empleado
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/usuarios/{{idEmpleado}}
  body: json
  auth: bearer
}

body:json {
  {
    "nombre": "Editado",
    "telefono": "5533334444"
  }
}

auth:bearer {
  token: {{token}}
}

tests {
  test("editar empleado: 200", () => {
    expect(res.status).to.equal(200);
    expect(res.body.nombre).to.equal("Editado");
    expect(res.body.telefono).to.equal("5533334444");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
