meta {
  name: Desbloquear empleado
  type: http
  seq: 20
}

patch {
  url: {{baseUrl}}/usuarios/{{idEmpleado}}/desbloqueo
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("desbloquear empleado: 200", () => {
    expect(res.status).to.equal(200);
    expect(res.body.estado).to.equal("ACTIVO");
    expect(res.body.motivoBloqueo).to.equal(null);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
