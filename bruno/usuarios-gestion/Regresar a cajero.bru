meta {
  name: Regresar a cajero
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/usuarios/{{idEmpleado}}
  body: json
  auth: bearer
}

body:json {
  {
    "rol": "CAJERO"
  }
}

auth:bearer {
  token: {{token}}
}

tests {
  test("regresar a cajero: 200", () => {
    expect(res.status).to.equal(200);
    expect(res.body.rol.nombre).to.equal("CAJERO");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
