meta {
  name: Bloquear sin motivo
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/usuarios/{{idEmpleado}}/bloqueo
  body: json
  auth: bearer
}

body:json {
  {
    "motivo": ""
  }
}

auth:bearer {
  token: {{token}}
}

tests {
  test("bloquear sin motivo: 400", () => {
    expect(res.status).to.equal(400);
    expect(res.body.errors).to.have.property("motivo");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
