meta {
  name: Editar perfil sin token
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/usuarios/me
  body: json
  auth: none
}

body:json {
  {
    "telefono": "5512345678"
  }
}

tests {
  test("sin token: 401", () => {
    expect(res.status).to.equal(401);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
