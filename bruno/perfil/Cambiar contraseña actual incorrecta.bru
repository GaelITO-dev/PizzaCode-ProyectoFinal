meta {
  name: Cambiar contraseña actual incorrecta
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/usuarios/me/contrasena
  body: json
  auth: bearer
}

body:json {
  {
    "contrasenaActual": "NoEsMiClave#1",
    "contrasenaNueva": "Cliente#2027"
  }
}

auth:bearer {
  token: {{token}}
}

tests {
  test("actual incorrecta: 422", () => {
    expect(res.status).to.equal(422);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
