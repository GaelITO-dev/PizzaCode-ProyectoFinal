meta {
  name: Cambiar contraseña
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/usuarios/me/contrasena
  body: json
  auth: bearer
}

body:json {
  {
    "contrasenaActual": "Cliente#2026",
    "contrasenaNueva": "Cliente#2027"
  }
}

auth:bearer {
  token: {{token}}
}

tests {
  test("contraseña cambiada: 204", () => {
    expect(res.status).to.equal(204);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
