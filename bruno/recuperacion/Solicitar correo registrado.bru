meta {
  name: Solicitar correo registrado
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/recuperar
  body: json
  auth: none
}

body:json {
  {
    "correo": "admin@pizzacode.mx"
  }
}

tests {
  test("solicitar correo registrado: 200", () => {
    expect(res.status).to.equal(200);
    expect(res.body.message).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
