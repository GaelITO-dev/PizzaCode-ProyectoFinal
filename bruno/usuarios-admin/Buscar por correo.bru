meta {
  name: Buscar por correo
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/usuarios?busqueda=cliente@pizzacode
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("buscar por correo: 200", () => {
    expect(res.status).to.equal(200);
    expect(res.body.page.totalElements).to.be.at.least(1);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
