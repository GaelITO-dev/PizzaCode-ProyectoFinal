meta {
  name: Listar usuarios
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/usuarios
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("lista paginada: 200", () => {
    expect(res.status).to.equal(200);
    expect(res.body.content).to.be.an("array");
    expect(res.body.page.size).to.equal(8);
    expect(res.body.page.totalElements).to.be.above(0);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
