meta {
  name: Login ADMIN (guarda token)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "admin@pizzacode.mx",
    "contrasena": "Admin#2026"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("token", res.getBody().token);
  }
}
