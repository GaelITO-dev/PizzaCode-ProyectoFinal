meta {
  name: Registro datos invalidos
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/auth/registro
  body: json
  auth: inherit
}

body:json {
  {
    "nombre": "",
    "apellidoPat": "B",
    "correo": "no-es-correo",
    "telefono": "55 abc",
    "contrasena": "corta"
  }
}

tests {
  test("rechaza datos inválidos: 400", () => {
    expect(res.status).to.equal(400);
  });
  
  test("trae un error por cada campo inválido", () => {
    expect(res.body.errors).to.have.property("nombre");
    expect(res.body.errors).to.have.property("apellidoPat");
    expect(res.body.errors).to.have.property("correo");
    expect(res.body.errors).to.have.property("telefono");
    expect(res.body.errors).to.have.property("contrasena");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
