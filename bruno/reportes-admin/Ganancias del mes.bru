meta {
  name: Ganancias del mes
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/reportes/ganancias?desde={{inicioMes}}&hasta={{finMes}}
  body: none
  auth: bearer
}

params:query {
  desde: {{inicioMes}}
  hasta: {{finMes}}
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  const f = (d) => d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
  const hoy = new Date();
  const hace6 = new Date(hoy); hace6.setDate(hoy.getDate() - 6);
  const inicioMes = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
  const finMes = new Date(hoy.getFullYear(), hoy.getMonth() + 1, 0);
  bru.setVar("hoy", f(hoy));
  bru.setVar("hace6", f(hace6));
  bru.setVar("inicioMes", f(inicioMes));
  bru.setVar("finMes", f(finMes));
}

tests {
  test("ganancias del mes: 200", () => {
    expect(res.status).to.equal(200);
    expect(res.body.desdeAnterior).to.match(/-01$/);
    expect(res.body.ventasAnterior).to.be.a("number");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
