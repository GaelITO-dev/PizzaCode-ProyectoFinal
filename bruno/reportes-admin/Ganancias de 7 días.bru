meta {
  name: Ganancias de 7 días
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/reportes/ganancias?desde={{hace6}}&hasta={{hoy}}
  body: none
  auth: bearer
}

params:query {
  desde: {{hace6}}
  hasta: {{hoy}}
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  const f = (d) => d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
  const hoy = new Date();
  const hace6 = new Date(hoy); hace6.setDate(hoy.getDate() - 6);
  const inicioMes = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
  const finMes = new Date(hoy.getFullYear(), hoy.getMonth() + 1, 0);
  bru.setVar("hoy", f(hoy));
  bru.setVar("hace6", f(hace6));
  bru.setVar("inicioMes", f(inicioMes));
  bru.setVar("finMes", f(finMes));
}

tests {
  test("reporte de 7 días consistente", () => {
    expect(res.status).to.equal(200);
    expect(res.body.agrupacion).to.equal("DIA");
    expect(res.body.serie).to.have.lengthOf(7);
    expect(res.body.masVendidos.length).to.be.at.most(5);
    expect(res.body.porOrigen).to.be.an("array");
    expect(res.body.porMetodoPago).to.be.an("array");
    const sumaSerie = res.body.serie.reduce((s, p) => s + Number(p.total), 0);
    expect(Math.abs(sumaSerie - Number(res.body.ventas))).to.be.below(0.01);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
