meta {
  name: Mis pedidos buscar producto (CLIENTE)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/pedidos/mis-pedidos?buscar=pepperoni
  body: none
  auth: bearer
}

params:query {
  buscar: pepperoni
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
