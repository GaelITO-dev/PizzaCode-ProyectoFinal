meta {
  name: Login Cliente
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "correo": "cliente@pizzacode.mx",
    "contrasena": "Cliente#2026"
  }
}

script:post-response {
  bru.setVar("token", res.body.token);
}

tests {
  test("trae nombre y apellido para el avatar", () => {
    expect(res.body.nombre).to.be.a("string");
    expect(res.body.apellidoPat).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
