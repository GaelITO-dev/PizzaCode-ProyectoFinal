meta {
  name: Correo de prueba
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/correo/prueba
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("200 con para, enviado y configurado", function() {
    expect(res.status).to.equal(200);
    expect(res.body.para).to.be.a("string");
    expect(res.body.enviado).to.be.a("boolean");
    expect(res.body.configurado).to.be.a("boolean");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
