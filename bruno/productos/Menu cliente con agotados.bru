meta {
  name: Menu cliente con agotados
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/productos?todos=true&page=0&size=24
  body: none
  auth: bearer
}

params:query {
  todos: true
  page: 0
  size: 24
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
