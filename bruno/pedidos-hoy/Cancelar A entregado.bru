meta {
  name: Cancelar A entregado
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/pedidos/{{idPedidoA}}/cancelar
  body: json
  auth: bearer
}

body:json {
  { "motivo": "Prueba" }
}

auth:bearer {
  token: {{token}}
}

tests {
  test("cancelar A entregado: 422", () => {
    expect(res.status).to.equal(422);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
