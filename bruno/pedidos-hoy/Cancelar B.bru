meta {
  name: Cancelar B
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/pedidos/{{idPedidoB}}/cancelar
  body: json
  auth: bearer
}

body:json {
  { "motivo": "El cliente ya no lo quiso" }
}

auth:bearer {
  token: {{token}}
}

tests {
  test("cancelar B: 200", () => {
    expect(res.status).to.equal(200);
    expect(res.body.estado).to.equal("CANCELADO");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
